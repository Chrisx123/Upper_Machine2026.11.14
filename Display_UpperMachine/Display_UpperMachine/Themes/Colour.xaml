<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush"           Color="#1E1E2E"/>
    <SolidColorBrush x:Key="PanelBrush"        Color="#252A34"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#3A3F4B"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="#0E7AC4"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#1493E8"/>
    <SolidColorBrush x:Key="TextBrush"         Color="#E6E6E6"/>
    <SolidColorBrush x:Key="SubTextBrush"      Color="#9AA0AA"/>
    <SolidColorBrush x:Key="GoodBrush"         Color="#2ECC71"/>
    <SolidColorBrush x:Key="BadBrush"          Color="#E74C3C"/>
    <SolidColorBrush x:Key="ButtonBgBrush"     Color="#2F3542"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"  Color="#3D4454"/>
    <SolidColorBrush x:Key="CloseBrush"        Color="#FF4D4F"/>
    <!-- 鲜明红 -->
    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#FF7875"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#D9363E"/>
</ResourceDictionary>